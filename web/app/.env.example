VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Same-origin in prod (the /api/proxy route is colocated with the SPA on Vercel).
VITE_PROXY_URL=/api/proxy
VITE_PROBE_URL=/api/probe

# Optional: Trakt scrobble.
# Register an OAuth app at https://trakt.tv/oauth/applications with
# Redirect URI = https://<your-host>/auth/trakt/callback.
# The client_id is safe to expose to the browser; the secret is server-only.
VITE_TRAKT_CLIENT_ID=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
