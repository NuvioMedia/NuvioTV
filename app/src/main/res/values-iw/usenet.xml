<resources>
    <string name="usenet_title">Usenet</string>
    <string name="stream_test_local_stream">הזרם האחרון הוגש מהמכשיר הזה ונסגר עם ההפעלה שלו, ולכן אין שרת לבדיקה.</string>
    <string name="usenet_hole_filling">מילוי מאמרים חסרים</string>
    <string name="usenet_hole_filling_description">ניסיון להמשיך דרך פערים קטנים בסרטון פגום. תוכן חסר עלול לגרום לתקלות בתמונה או בשמע, וייתכן שחלק מהסרטונים עדיין ייכשלו. כבוי כברירת מחדל. חל על הזרם הבא.</string>
    <string name="usenet_max_missing_articles">מספר מרבי של מאמרים חסרים</string>
    <string name="usenet_max_missing_articles_description">סך המאמרים החסרים המותרים בהפעלה אחת (1–50). ערכים נמוכים דוחים מקורות פגומים מהר יותר.</string>
    <string name="usenet_max_consecutive_missing">מספר מרבי של מאמרים חסרים ברצף</string>
    <string name="usenet_max_consecutive_missing_description">הפער הגדול ביותר המותר ברצף (1–10). ערכים נמוכים מתירים רק הפרעות קטנות יותר. מאמרי כותרת חיוניים אינם מתמלאים לעולם.</string>
    <string name="usenet_self_hosted">אפשור שרתים באירוח עצמי</string>
    <string name="usenet_self_hosted_description">מתן אפשרות לכתובות NZB וספקים שסופקו על ידי תוסף, ברשת המקומית או במכשיר הזה. יש להפעיל רק עבור תוספים ושירותים באירוח עצמי מהימנים. כתובות link-local נשארות חסומות. חל על הזרם הבא.</string>
