    <string name="usenet_diag_reused">המנוע כבר פועל</string>
    <string name="usenet_diag_nzb_notes">קריאות הגוף חופפות להורדה ולעיבוד. זמן העיבוד אינו כולל את זמן קריאת הגוף; עבודת מערכת הקבצים כלולה באינדוקס ובכתיבה. אלה מדידות שעון קיר.</string>
    <string name="usenet_fallback_max_attempts">מספר מרבי של ניסיונות חלופה</string>
    <string name="usenet_fallback_max_attempts_description">ניסיון עד מספר זה של זרמים חלופיים כשהחלופה האוטומטית מופעלת (1–50). תקציב ההכנה של שתי דקות עדיין חל. השינויים חלים בבחירת הזרם הבאה.</string>
    <string name="usenet_prefetch_results">טעינה מראש של תוצאת Usenet ראשונה</string>
    <string name="usenet_prefetch_results_description">הכנת תוצאת ה-Usenet הראשונה מיד בדף תוצאות הזרמים ושמירתה מוכנה עד שתי דקות. צורך חיבורי ספק ורוחב פס מסוים.</string>
    <string name="usenet_cache_nzb">שמירת קובצי NZB במטמון</string>
    <string name="usenet_cache_nzb_description">שמירת קובצי NZB של עד 64 MiB כל אחד במטמון, בעד 256 MiB של אחסון. הקבצים פגים לאחר 14 ימים ללא שימוש; הקבצים ששימשו לאחרונה לפני זמן רב ביותר מוסרים כשצריך מקום. פועל עם NZB לא דחוסים ובין הפעלות מחדש של האפליקציה. כיבוי האפשרות מנקה את המטמון.</string>
