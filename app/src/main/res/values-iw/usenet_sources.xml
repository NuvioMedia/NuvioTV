    <string name="usenet_provider_tune">כוונון חיבורים</string>
    <string name="usenet_provider_tune_description">מציאת מגבלת החיבורים, היציאה ומכסת החיבורים שעובדות הכי טוב ברשת הזו</string>
    <string name="usenet_provider_tune_title">כוונון %1$s</string>
    <string name="usenet_provider_tune_intro">בודק כמה חיבורים החשבון מקבל, ואז מודד את מהירות ההורדה ביציאות הספק ועם מספר גדל והולך של חיבורים. התהליך אורך כשתי דקות ומוריד הרבה נתוני בדיקה: לרוב יותר מ-1 GB, ועד כ-4 GB בקו מהיר. הוא נספר מול חשבון מסוג block. אין להפעיל דבר בינתיים. מכשירים אחרים שמשתמשים בחשבון באותו זמן מורידים את המגבלה שנמצאת. דבר אינו נשמר עד להחלת התוצאה.</string>
