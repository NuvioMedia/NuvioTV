    <string name="usenet_provider_priority_hint">ספקים בעלי אותה עדיפות חולקים את התעבורה. עדיפויות נמוכות משמשות רק למאמרים שחסרים בעדיפויות הגבוהות.</string>
    <string name="usenet_indexer_priority_hint">העדיפות מסדרת את האינדקסרים שלך. היא קובעת איזה עותק של מהדורה כפולה נשמר כש-“הסתרת מהדורות חוזרות” מופעלת, ואילו אינדקסרים מחופשים קודם כש-“חיפוש בעדיפויות נמוכות רק כחלופה” מופעלת.</string>
    <string name="usenet_indexer_fallback">חיפוש בעדיפויות נמוכות רק כחלופה</string>
    <string name="usenet_indexer_fallback_description">כבוי: כל אינדקסר מחופש. מופעל: אינדקסרים בעדיפות נמוכה מחופשים רק כשהגבוהים לא מוצאים דבר, וכך נחסכות בקשות API.</string>
    <string name="usenet_hide_duplicates">הסתרת מהדורות חוזרות</string>
    <string name="usenet_show_release_names">הצגת שמות מהדורות</string>
    <string name="usenet_show_release_names_description">הצגת שם הגרסה של כל תוצאה מעל הפרטים שלה. מוסתר, קבוצת הגרסה שלה מסיימת את הפרטים.</string>
    <string name="usenet_hide_duplicates_description">הצגת מהדורה שנמצאה בכמה אינדקסרים פעם אחת, מהאינדקסר בעל העדיפות הגבוהה ביותר.</string>
