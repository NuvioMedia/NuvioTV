<resources>
    <string name="usenet_title">Usenet</string>
    <string name="stream_test_local_stream">Zadnji stream poslužen je s ovog uređaja i zatvoren je zajedno s reprodukcijom, pa nema poslužitelja za testiranje.</string>
    <string name="usenet_hole_filling">Popuni nedostajuće članke</string>
    <string name="usenet_hole_filling_description">Pokušaj nastaviti preko malih praznina u oštećenom videu. Nedostajući sadržaj može uzrokovati smetnje u slici ili zvuku, a neki videozapisi i dalje mogu ne uspjeti. Zadano isključeno. Primjenjuje se na sljedeći stream.</string>
    <string name="usenet_max_missing_articles">Najveći broj nedostajućih članaka</string>
    <string name="usenet_max_missing_articles_description">Ukupan broj nedostajućih članaka dopušten tijekom jedne reprodukcije (1–50). Niže vrijednosti ranije odbacuju oštećene izvore.</string>
    <string name="usenet_max_consecutive_missing">Najveći broj uzastopnih nedostajućih članaka</string>
    <string name="usenet_max_consecutive_missing_description">Najveća dopuštena uzastopna praznina (1–10). Niže vrijednosti dopuštaju samo manje prekide. Ključni članci zaglavlja nikada se ne popunjavaju.</string>
    <string name="usenet_self_hosted">Dopusti vlastite poslužitelje</string>
    <string name="usenet_self_hosted_description">Dopusti NZB adrese i adrese pružatelja koje daju dodaci na tvojoj lokalnoj mreži ili ovom uređaju. Omogući samo za pouzdane dodatke i vlastite usluge. Link-local adrese ostaju blokirane. Primjenjuje se na sljedeći stream.</string>
