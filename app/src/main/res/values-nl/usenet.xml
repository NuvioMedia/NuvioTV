<resources>
    <string name="usenet_title">Usenet</string>
    <string name="stream_test_local_stream">De laatste stream werd vanaf dit apparaat geleverd en is samen met het afspelen gesloten, dus er is geen server om te testen.</string>
    <string name="usenet_hole_filling">Ontbrekende artikelen opvullen</string>
    <string name="usenet_hole_filling_description">Probeer door kleine gaten in een beschadigde video heen te blijven spelen. Ontbrekende inhoud kan beeld- of geluidsstoringen veroorzaken en sommige video\'s kunnen alsnog mislukken. Standaard uit. Geldt voor de volgende stream.</string>
    <string name="usenet_max_missing_articles">Maximum aantal ontbrekende artikelen</string>
    <string name="usenet_max_missing_articles_description">Totaal aantal ontbrekende artikelen dat per afspeelsessie is toegestaan (1–50). Lagere waarden wijzen beschadigde bronnen sneller af.</string>
    <string name="usenet_max_consecutive_missing">Maximum aantal opeenvolgende ontbrekende artikelen</string>
    <string name="usenet_max_consecutive_missing_description">Grootste toegestane aaneengesloten gat (1–10). Lagere waarden staan alleen kleinere onderbrekingen toe. Essentiële headerartikelen worden nooit opgevuld.</string>
    <string name="usenet_self_hosted">Zelfgehoste servers toestaan</string>
    <string name="usenet_self_hosted_description">Sta door add-ons aangeleverde NZB- en provideradressen op je lokale netwerk of op dit apparaat toe. Schakel dit alleen in voor vertrouwde add-ons en zelfgehoste diensten. Link-local-adressen blijven geblokkeerd. Geldt voor de volgende stream.</string>
