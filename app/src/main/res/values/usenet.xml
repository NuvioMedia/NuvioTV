    <string name="usenet_diag_reused">Engine already running</string>
    <string name="usenet_diag_nzb_notes">Body reads overlap downloading and parsing. Parse work excludes body read time; filesystem work is included in index and write. These are wall-clock measurements.</string>
    <string name="usenet_fallback_max_attempts">Maximum Fallback Attempts</string>
    <string name="usenet_fallback_max_attempts_description">Try up to this many alternative streams when automatic fallback is enabled (1–50). The two-minute preparation budget still applies. Changes apply to the next stream selection.</string>
    <string name="usenet_prefetch_results">Prefetch First Usenet Result</string>
    <string name="usenet_prefetch_results_description">Prepare the first Usenet result immediately on the stream results page and keep it ready for up to two minutes. Uses provider connections and some bandwidth.</string>
    <string name="usenet_cache_nzb">Cache NZB Files</string>
    <string name="usenet_cache_nzb_description">Cache NZB files up to 64 MiB each, using up to 256 MiB of storage. Files expire after 14 days without use; least recently used files are removed when space is needed. Works with uncompressed NZBs and across app restarts. Turning this off clears the cache.</string>
    <string name="usenet_fast_mkv">Fast MKV Startup</string>
    <string name="usenet_fast_nzb">Fast NZB Fetch</string>
    <string name="usenet_fast_nzb_description">Request compressed NZB metadata to reduce startup latency. Applies to the next stream.</string>
