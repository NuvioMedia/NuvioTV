# Generate strong random values for the three secrets:
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)
#   REDIS_PASSWORD=$(openssl rand -hex 24)
#   ADMIN_KEY=$(openssl rand -hex 32)

POSTGRES_PASSWORD=
REDIS_PASSWORD=
ADMIN_KEY=

# Public URL of the addon (must match the Pangolin resource hostname).
# Baked into manifest URLs that get persisted in client storage, so do not
# change after first save without coordinating a client-side reset.
HOST_NAME=https://aiometadata.omnio.tv

# Trakt OAuth — shared client credentials, same values as the Fly deploy.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
